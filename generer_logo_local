def generer_logo_local(prompt_net):
    """
    Génère un logo artistique avec Stable Diffusion en local.
    """
    try:
        import torch
        from diffusers import StableDiffusionPipeline
        
        # Chargement du modèle (v1.5 est le plus léger et rapide pour commencer)
        model_id = "runwayml/stable-diffusion-v1-5"
        pipe = StableDiffusionPipeline.from_pretrained(
            model_id, 
            torch_dtype=torch.float16
        )
        # On tente d'utiliser CUDA (NVIDIA), sinon on reste sur CPU
        device = "cuda" if torch.cuda.is_available() else "cpu"
        pipe = pipe.to(device)
        
        # Le prompt optimisé pour un logo
        prompt = f"Professional minimalist logo for: {prompt_net}, vector style, clean lines, flat design, high quality"
        
        image = pipe(prompt, num_inference_steps=20).images[0]
        return image
        
    except Exception as e:
        print(f"Erreur génération locale : {e}")
        return None
