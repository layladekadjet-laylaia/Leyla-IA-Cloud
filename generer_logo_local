def generer_logo_local(prompt_net):
    """
    Génère un visuel propre et rapide sans surcharger la mémoire du serveur cloud.
    """
    try:
        from PIL import Image, ImageDraw
        
        taille = 800
        img = Image.new("RGBA", (taille, taille), (15, 23, 42, 255))
        draw = ImageDraw.Draw(img)
        
        # Formes géométriques élégantes pour illustrer le logo
        draw.ellipse([200, 200, 600, 600], outline=(56, 189, 248), width=12)
        draw.rectangle([300, 370, 500, 430], fill=(244, 63, 94))
        
        return img
    except Exception as e:
        print(f"Erreur : {e}")
        return None
